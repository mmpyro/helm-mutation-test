<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mutation report — {{CHART}}</title>
<style>
  :root {
    --fg: #1a1a1a; --bg: #fff; --muted: #666; --rule: #e3e3e3;
    --good: #1a7f37; --okay: #9a6700; --poor: #cf222e; --code: #f6f8fa;
  }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e6e6e6; --bg: #0d1117; --muted: #9198a1; --rule: #30363d;
            --good: #3fb950; --okay: #d29922; --poor: #f85149; --code: #161b22; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 2rem 1.5rem 4rem; color: var(--fg); background: var(--bg);
         font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; }
  main { max-width: 62rem; margin: 0 auto; }
  h1 { font-size: 1.3rem; font-weight: 600; margin: 0 0 .25rem; }
  h2 { font-size: 1.05rem; font-weight: 600; margin: 2.5rem 0 .75rem;
       padding-bottom: .35rem; border-bottom: 1px solid var(--rule); }
  .sub { color: var(--muted); margin: 0 0 2rem; font-size: .9rem; }
  .score { font-size: 3.2rem; font-weight: 650; line-height: 1; letter-spacing: -.02em; }
  .score.good { color: var(--good); } .score.okay { color: var(--okay); } .score.poor { color: var(--poor); }
  .score small { font-size: .9rem; font-weight: 400; color: var(--muted); display: block;
                 margin-top: .5rem; letter-spacing: 0; }
  table { border-collapse: collapse; width: 100%; font-size: .9rem; }
  th, td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid var(--rule); }
  th { font-weight: 500; width: 9rem; }
  td:nth-child(2) { text-align: right; width: 4rem; font-variant-numeric: tabular-nums; }
  td:last-child { color: var(--muted); }
  tr.killed th { color: var(--good); } tr.survived th { color: var(--poor); }
  tr.muted th, tr.muted td { color: var(--muted); }
  tr.total th, tr.total td { font-weight: 500; }
  tr.warn th, tr.warn td { color: var(--okay); }
  ol.survivors { list-style: none; padding: 0; margin: 0; }
  ol.survivors li { margin: 0 0 1.4rem; }
  code.loc { font-weight: 600; font-size: .88rem; }
  .mut { color: var(--muted); font-size: .82rem; margin-left: .5rem; }
  pre { background: var(--code); border: 1px solid var(--rule); border-radius: 6px;
        padding: .6rem .8rem; overflow-x: auto; font-size: .82rem; margin: .4rem 0 .3rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .del { color: var(--poor); } .add { color: var(--good); }
  .note { color: var(--muted); font-size: .8rem; margin: 0; }
  .none { color: var(--good); }
  .viewer { margin-top: 1rem; }
  .fallback { color: var(--muted); font-size: .85rem; }
</style>
</head>
<body>
<main>
  <h1>Mutation report — {{CHART}}</h1>
  <p class="sub">Generated by helm-mutation-test. A <em>survived</em> mutant is a
     change to the chart that no test objected to: a missing assertion.</p>

  <div class="score {{BAND}}">{{SCORE}}%<small>mutation score — killed ÷ (killed + survived)</small></div>

  <h2>Outcomes</h2>
  <table>{{SUMMARY}}</table>

  <h2>Survived mutants</h2>
  {{SURVIVORS}}

  <h2>Annotated source</h2>
  <p class="fallback">Rendered by the mutation-testing-elements viewer. If it does
     not appear, the summary above is complete on its own.</p>
  <div class="viewer">
    <mutation-test-report-app titlePostfix="{{CHART}}">
      Loading the interactive viewer…
    </mutation-test-report-app>
  </div>
</main>

<script id="mutation-report" type="application/json">{{REPORT}}</script>
<script>
  // Feed the embedded standard-schema report to the viewer once it is defined.
  (function () {
    var el = document.querySelector('mutation-test-report-app');
    var raw = document.getElementById('mutation-report').textContent;
    try { el.report = JSON.parse(raw); }
    catch (e) { el.textContent = 'Could not parse the embedded report: ' + e.message; }
  })();
</script>
<script type="module"
        src="https://cdn.jsdelivr.net/npm/mutation-testing-elements@3/dist/mutation-test-elements.js"></script>
</body>
</html>
